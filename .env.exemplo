# Configuração de Provedor e Modelo LLM
# Exemplos suportados pelo Agno:
# Google Gemini: MODELO_LLM=google:gemini-2.0-flash
# Groq: MODELO_LLM=groq:llama-3.3-70b-versatile
# Ollama: MODELO_LLM=ollama:llama3.2
MODELO_LLM=google:gemini-2.0-flash

# Chaves de API (preencha conforme o provedor utilizado)
GEMINI_API_KEY=
GROQ_API_KEY=

# Banco SQLite para persistência de sessões, memória e histórico
BANCO_SQLITE=dados/tutor_curriculos.db

# Configuração do Servidor AgentOS
PORTA=7777
AGNO_TELEMETRY=false
